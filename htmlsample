<!DOCTYPE html> <html lang="en"> <head> <meta charset="UTF-8"> <meta name="viewport" content="width=device-width, initial-scale=1.0"> <title>Accessible Cost-Volume-Profit (CVP) Analysis Tool</title> <script src="https://cdn.jsdelivr.net/npm/chart.js"></script> <style> :root{ --primary:#0b57d0; --border:#1f2937; --bg:#ffffff; --panel:#f8fafc; --text:#111827; --profit:#0f5132; --loss:#842029; } *{ box-sizing:border-box; } body{ margin:0; font-family:Arial, Helvetica, sans-serif; line-height:1.5; color:var(--text); background:#fff; } header{ background:#0b57d0; color:#fff; padding:1.5rem; } main{ max-width:1200px; margin:auto; padding:1rem; } section{ margin-bottom:2rem; } h1,h2,h3{ margin-top:0; } .instructions, .card, .chart-section, .table-section, .controls{ border:2px solid var(--border); border-radius:8px; background:var(--panel); padding:1rem; } fieldset{ border:2px solid var(--border); padding:1rem; } legend{ font-weight:bold; } .grid{ display:grid; gap:1rem; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); } .form-group{ display:flex; flex-direction:column; } label{ font-weight:bold; margin-bottom:.25rem; } input[type="number"]{ padding:.5rem; border:2px solid #333; border-radius:4px; font-size:1rem; } input[type="range"]{ width:100%; } input:focus, button:focus, select:focus{ outline:4px solid #ffbf47; outline-offset:2px; } .summary-grid{ display:grid; gap:1rem; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); } .card{ background:#fff; } .card-value{ font-size:1.8rem; font-weight:bold; } .status-profit{ color:var(--profit); font-weight:bold; } .status-loss{ color:var(--loss); font-weight:bold; } .status-even{ font-weight:bold; } .chart-container{ position:relative; height:450px; } canvas{ background:#fff; border:2px solid var(--border); } .caption{ margin-top:.75rem; font-weight:bold; } .visually-hidden{ position:absolute; left:-10000px; width:1px; height:1px; overflow:hidden; } table{ width:100%; border-collapse:collapse; background:#fff; } caption{ font-weight:bold; text-align:left; margin-bottom:.5rem; } th, td{ border:2px solid #333; padding:.5rem; text-align:right; } th:first-child, td:first-child{ text-align:center; } footer{ margin-top:2rem; padding:1rem; text-align:center; border-top:2px solid #333; } .break-even-box{ margin-top:1rem; padding:.75rem; border:2px solid #333; background:#fff; } @media (max-width:700px){ .chart-container{ height:350px; } } </style> </head> <body> <header> <h1>Accessible Cost-Volume-Profit (CVP) Analysis Tool</h1> </header> <main> <section class="instructions" aria-labelledby="instructions-heading"> <h2 id="instructions-heading">How to Use This Tool</h2> <p> Enter assumptions for sales price, variable cost, and fixed costs. Use the volume slider or volume input to select a unit volume. </p> <p> Review the summary cards to see revenue, total cost, and profit. The chart compares revenue and total cost across different unit volumes. The point where revenue and total cost intersect is the break-even point. </p> <p> A supporting table below the chart summarizes values at selected volumes. </p> </section> <section class="controls" aria-labelledby="input-heading"> <h2 id="input-heading">CVP Inputs</h2> <form> <fieldset> <legend>Financial Assumptions</legend> <div class="grid"> <div class="form-group"> <label for="salesPrice">Sales Price per Unit ($)</label> <input id="salesPrice" type="number" value="50" min="1"> </div> <div class="form-group"> <label for="variableCost">Variable Cost per Unit ($)</label> <input id="variableCost" type="number" value="30" min="0"> </div> <div class="form-group"> <label for="fixedCost">Total Fixed Costs ($)</label> <input id="fixedCost" type="number" value="10000" min="0"> </div> <div class="form-group"> <label for="volumeInput">Selected Unit Volume</label> <input id="volumeInput" type="number" value="500" min="0" max="1000"> </div> </div> <div style="margin-top:1rem;"> <label for="volumeSlider"> Unit Volume Slider </label> <input id="volumeSlider" type="range" min="0" max="1000" value="500" aria-describedby="volumeHelp"> <div id="volumeHelp"> Use arrow keys or drag the slider to change volume. </div> </div> </fieldset> </form> </section> <section aria-labelledby="summary-heading"> <h2 id="summary-heading">Selected Results</h2> <div class="summary-grid"> <div class="card"> <h3>Revenue</h3> <div id="revenueValue" class="card-value" aria-live="polite"> </div> </div> <div class="card"> <h3>Total Cost</h3> <div id="costValue" class="card-value" aria-live="polite"> </div> </div> <div class="card"> <h3>Profit / Loss</h3> <div id="profitValue" class="card-value" aria-live="polite"> </div> </div> </div> <div class="break-even-box"> <strong>Break-Even Units:</strong> <span id="breakEvenValue" aria-live="polite"></span> </div> </section> <section class="chart-section" aria-labelledby="chart-heading"> <h2 id="chart-heading">Revenue and Cost Chart</h2> <p id="chartDescription"> This chart compares revenue and total cost across unit volumes. Revenue uses a solid line with circular markers. Total cost uses a dashed line with square markers. The selected volume is highlighted. The break-even point is where revenue and total cost intersect. </p> <div class="chart-container"> <canvas id="cvpChart" role="img" aria-label="Cost Volume Profit chart showing revenue and total cost by unit volume" aria-describedby="chartDescription chartSummary"> </canvas> </div> <p class="caption"> Figure 1. Revenue and Total Cost across unit volumes. </p> <div id="chartSummary" aria-live="polite" style="margin-top:1rem;font-weight:bold;"> </div> <div id="screenReaderAnnouncements" class="visually-hidden" aria-live="polite"> </div> </section> <section class="table-section" aria-labelledby="table-heading"> <h2 id="table-heading">Supporting Data Table</h2> <table id="dataTable"> <caption> Revenue, Total Cost, and Profit at selected unit volumes </caption> <thead> <tr> <th scope="col">Units</th> <th scope="col">Revenue</th> <th scope="col">Total Cost</th> <th scope="col">Profit</th> </tr> </thead> <tbody></tbody> </table> </section> </main> <footer> Accessible CVP Analysis Tool </footer> <script> const salesPriceInput = document.getElementById("salesPrice"); const variableCostInput = document.getElementById("variableCost"); const fixedCostInput = document.getElementById("fixedCost"); const volumeInput = document.getElementById("volumeInput"); const volumeSlider = document.getElementById("volumeSlider"); const revenueValue = document.getElementById("revenueValue"); const costValue = document.getElementById("costValue"); const profitValue = document.getElementById("profitValue"); const breakEvenValue = document.getElementById("breakEvenValue"); const chartSummary = document.getElementById("chartSummary"); const announcements = document.getElementById("screenReaderAnnouncements"); function currency(v){ return v.toLocaleString(undefined,{ style:"currency", currency:"USD", maximumFractionDigits:0 }); } const ctx = document.getElementById("cvpChart"); const chart = new Chart(ctx,{ type:"line", data:{ labels:[], datasets:[ { label:"Revenue (Solid Line, Circle Markers)", data:[], borderColor:"#003366", backgroundColor:"#003366", borderWidth:3, pointRadius:4, pointStyle:"circle", tension:0 }, { label:"Total Cost (Dashed Line, Square Markers)", data:[], borderColor:"#000000", backgroundColor:"#000000", borderDash:[8,6], borderWidth:3, pointRadius:4, pointStyle:"rect", tension:0 } ] }, options:{ responsive:true, maintainAspectRatio:false, plugins:{ legend:{ labels:{ color:"#000", font:{ size:14, weight:"bold" } } } }, scales:{ x:{ title:{ display:true, text:"Unit Volume" } }, y:{ title:{ display:true, text:"Dollars" } } } } }); function updateTable(price,varCost,fixedCost,maxUnits){ const tbody = document.querySelector("#dataTable tbody"); tbody.innerHTML = ""; const rows = 10; for(let i=0;i<=rows;i++){ const units = Math.round((maxUnits/rows)*i); const revenue = units*price; const cost = fixedCost + units*varCost; const profit = revenue - cost; const tr = document.createElement("tr"); tr.innerHTML = ` <td>${units}</td> <td>${currency(revenue)}</td> <td>${currency(cost)}</td> <td>${currency(profit)}</td> `; tbody.appendChild(tr); } } function update(){ const price = Number(salesPriceInput.value); const varCost = Number(variableCostInput.value); const fixedCost = Number(fixedCostInput.value); let volume = Number(volumeInput.value); volumeSlider.value = volume; const revenue = volume * price; const cost = fixedCost + (volume * varCost); const profit = revenue - cost; revenueValue.textContent = currency(revenue); costValue.textContent = currency(cost); let statusClass = "status-even"; let statusText = "Break-even"; if(profit > 0){ statusClass = "status-profit"; statusText = "Profit"; } if(profit < 0){ statusClass = "status-loss"; statusText = "Loss"; } profitValue.innerHTML = `<span class="${statusClass}"> ${statusText}: ${currency(profit)} </span>`; const contributionMargin = price - varCost; let breakEvenUnits = "Not available"; if(contributionMargin > 0){ breakEvenUnits = Math.ceil(fixedCost / contributionMargin); } breakEvenValue.textContent = breakEvenUnits; const maxUnits = Math.max( 1000, Number(volume) + 200, breakEvenUnits * 1.5 || 1000 ); const labels = []; const revenueData = []; const costData = []; for(let i=0;i<=maxUnits;i+=25){ labels.push(i); revenueData.push(i * price); costData.push( fixedCost + (i * varCost) ); } chart.data.labels = labels; chart.data.datasets[0].data = revenueData; chart.data.datasets[1].data = costData; chart.update(); chartSummary.textContent = `Selected volume ${volume} units. Revenue ${currency(revenue)}. Total cost ${currency(cost)}. ${statusText} ${currency(profit)}. Break-even units ${breakEvenUnits}.`; announcements.textContent = chartSummary.textContent; updateTable( price, varCost, fixedCost, maxUnits ); } volumeSlider.addEventListener("input",()=>{ volumeInput.value = volumeSlider.value; update(); }); volumeInput.addEventListener("input",()=>{ volumeSlider.value = volumeInput.value; update(); }); [ salesPriceInput, variableCostInput, fixedCostInput ].forEach(control=>{ control.addEventListener( "input", update ); }); update(); </script> </body> </html>
